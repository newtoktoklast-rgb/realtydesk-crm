{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RealtyDesk",
  "version": "0.1.5",
  "identifier": "com.realtydesk.crm",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RealtyDesk",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgwMkUzNTI2QjczOUJGRTMKUldUanZ6bTNKalV1Z05HTkk0K005VWtnVEl3NlRzOWhMcXdOY3B5L1hBUnFkZk85R0JPSVQxQmEK",
      "endpoints": [
        "https://github.com/newtoktoklast-rgb/realtydesk-crm/releases/latest/download/latest.json"
      ]
    }
  }
}
